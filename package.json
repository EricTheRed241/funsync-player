{
  "name": "funsync-player",
  "version": "0.11.0",
  "description": "FunSync: funscript playback on stroker and vibration devices; the server (crates/funsync-server) plus the scout and library CLIs",
  "scripts": {
    "start": "npm run -s server:build && target/release/funsync-server --lan --supervise",
    "server": "npm run -s server:build && target/release/funsync-server",
    "server:build": "cargo build -q --release -p funsync-server && scripts/server-sign.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "backup": "node scripts/backup-ignored.mjs",
    "upgrade:axes": "node scripts/upgrade-multi-axis.mjs",
    "prune:generated": "node scripts/prune-generated.mjs",
    "eroscripts:sync": "node scripts/eroscripts-sync.mjs",
    "eroscripts:preview-check": "node scripts/eroscripts-preview-check.mjs",
    "eroscripts:scout": "node scripts/eroscripts-scout.mjs",
    "vrbangers:scout": "node scripts/eroscripts-scout.mjs --vrbangers",
    "manual:open": "node scripts/manual-open.mjs",
    "faptap:scout": "node scripts/faptap-scout.mjs",
    "dedupe:scenes": "node scripts/dedupe-scenes.mjs",
    "library:reorganize": "node scripts/library-reorganize.mjs",
    "video:tags": "cargo run -q --release -p video-tags --",
    "age:screen": "cargo run -q --release -p age-screen --",
    "pornstar:tags": "cargo run -q --release -p pornstar-tags --",
    "scout:report": "cargo run -q --release -p scout-report --",
    "slr:scout": "cargo run -q --release -p slr-scout --",
    "vrb:scout": "cargo run -q --release -p vrb-scout --",
    "pmvhaven:scout": "cargo run -q --release -p pmvhaven-scout --",
    "creators:scout": "cargo run -q --release -p creator-scout --",
    "creators:site": "cargo run -q --release -p creator-report --",
    "status:site": "cargo run -q --release -p status-site --",
    "jobs": "cargo run -q --release -p job-runner --",
    "library:thumbs": "cargo run -q --release -p library-thumbs --",
    "access:pin": "cargo run -q --release -p access-pin --",
    "app:autostart": "npm run -s server:build && target/release/funsync-server autostart"
  },
  "keywords": [
    "funscript",
    "buttplug",
    "tcode"
  ],
  "author": "FunSync",
  "license": "GPL-3.0-or-later",
  "private": true,
  "dependencies": {
    "jszip": "^3.10.1",
    "megajs": "^1.3.10"
  },
  "devDependencies": {
    "jsdom": "^29.0.2",
    "vitest": "^4.1.4"
  }
}
