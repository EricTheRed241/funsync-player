{
  "name": "funsync-player",
  "version": "0.9.2",
  "description": "Local desktop video player with Buttplug/Intiface and TCode device integration for synchronized funscript playback",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "backend:dev": "cd backend && python3 main.py || python main.py",
    "backend:test": "cd backend && python3 -m pytest -v || python -m pytest -v",
    "backup": "node scripts/backup-ignored.mjs",
    "upgrade:axes": "node scripts/upgrade-multi-axis.mjs",
    "prune:generated": "node scripts/prune-generated.mjs",
    "eroscripts:sync": "node scripts/eroscripts-sync.mjs",
    "eroscripts:preview-check": "node scripts/eroscripts-preview-check.mjs",
    "eroscripts:scout": "node scripts/eroscripts-scout.mjs",
    "vrbangers:scout": "node scripts/eroscripts-scout.mjs --vrbangers",
    "manual:open": "node scripts/manual-open.mjs",
    "faptap:scout": "node scripts/faptap-scout.mjs",
    "dedupe:scenes": "node scripts/dedupe-scenes.mjs",
    "library:reorganize": "node scripts/library-reorganize.mjs",
    "video:tags": "cargo run -q --release -p video-tags --",
    "age:screen": "cargo run -q --release -p age-screen --",
    "pornstar:tags": "cargo run -q --release -p pornstar-tags --",
    "k8s": "bash deploy/k8s/k8s.sh",
    "app:autostart": "bash deploy/macos/app-autostart.sh",
    "omp:broker": "bash deploy/macos/omp-broker.sh"
  },
  "keywords": [
    "video-player",
    "funscript",
    "buttplug",
    "tcode",
    "electron"
  ],
  "author": "FunSync",
  "license": "GPL-3.0-or-later",
  "private": true,
  "dependencies": {
    "buttplug": "^4.0.1",
    "electron-conf": "^1.3.0",
    "electron-log": "^5.4.3",
    "hls.js": "^1.6.16",
    "intl-messageformat": "^11.2.6",
    "jszip": "^3.10.1",
    "lucide": "^1.8.0",
    "qrcode-generator": "^2.0.4",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "electron": "^41.2.0",
    "jsdom": "^29.0.2",
    "megajs": "^1.3.10",
    "vitest": "^4.1.4"
  }
}
