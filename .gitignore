# Dependencies
# No trailing slash: a worktree's node_modules is a symlink, which `node_modules/` doesn't match.
node_modules

# Rust (Cargo workspace, crates/*)
/target

# Python
backend/__pycache__/
backend/.venv/
backend/*.pyc
*.pyc

# Environment / secrets
.env
.env.*

# Logs
*.log

# Runtime caches
thumbs/
scripts_cache/
.funsync/

# Bundled binaries (not checked in — download separately)
ffmpeg/*.exe
ffmpeg/*.zip

# Test media files (too large for git)
Test.mp4
Test-slow.funscript
Logo.ico
FS(1).png
ffmpeg-linux/*.zip
eroscripts-debug.log

# Claude Code
.claude/
notes/

# OS files
Thumbs.db
Desktop.ini
.DS_Store

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Bundled Twemoji artwork for category icons (~2.7 MB, 737 SVGs).
# Fetched by `node scripts/fetch-twemoji.mjs`, not committed — same
# treatment as ffmpeg/. Keeping generated third-party art out of history
# matters more than the 2.7 MB: every regeneration of the catalogue would
# otherwise add another copy, permanently.
# The manifest IS committed (it is small, and it keeps imports resolving in a
# fresh clone); a missing SVG degrades to font rendering, it does not break.
renderer/assets/emoji/
