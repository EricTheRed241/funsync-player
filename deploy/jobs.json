{
  "_comment": "FunSync's jobs, run on this Mac by job-runner (crates/job-runner), whose scheduler the desktop app starts. Orca automations decide when: each one runs `npm run jobs -- start <job>`. timeout: the run is stopped after this. steps run one after the other from the repo root; the job's exit code is the first that isn't 0 or 2, else 2 when a step left work, else 0.",
  "jobs": [
    {
      "name": "eroscripts-scout",
      "timeout": "12h",
      "steps": [
        ["npm", "run", "-s", "slr:scout", "--", "--fetch"],
        ["npm", "run", "-s", "eroscripts:scout", "--", "--daily", "--passes", "2", "--wait", "1h"]
      ]
    },
    {
      "name": "thumbnails",
      "timeout": "6h",
      "steps": [
        ["npm", "run", "-s", "eroscripts:scout", "--", "--frames", "300"],
        ["npm", "run", "-s", "library:thumbs"]
      ]
    },
    {
      "name": "pornstar-tags",
      "timeout": "30m",
      "steps": [["npm", "run", "-s", "pornstar:tags", "--", "--apply"]]
    },
    {
      "name": "age-screen",
      "timeout": "4h",
      "steps": [["npm", "run", "-s", "age:screen", "--", "--weekly"]]
    },
    {
      "name": "eroscripts-sync",
      "timeout": "4h",
      "steps": [["npm", "run", "-s", "eroscripts:sync"]]
    },
    {
      "name": "faptap-scout",
      "timeout": "6h",
      "steps": [["npm", "run", "-s", "faptap:scout"]]
    }
  ]
}
